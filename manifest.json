{
  "manifest_version": 3,
  "name": "Blossom Lingo",
  "version": "1.0.4",
  "description": "Translate LeetCode Explore pages locally with Ollama.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "http://127.0.0.1:11434/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Blossom Lingo" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/explore/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
